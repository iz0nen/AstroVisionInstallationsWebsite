# ==========================================
# 1. SECRET CREDENTIALS & SENSITIVE KEYS
# ==========================================
# This blocks your EmailJS API keys and passwords from leaking publicly.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# 2. LOCAL DEPENDENCIES (DEPENDENCY PACKAGES)
# ==========================================
# Never upload node_modules. It is a massive folder created automatically 
# from your package.json dependencies when your site builds on Vercel.
node_modules/
jspm_packages/

# ==========================================
# 3. BUILD OUTPUTS & COMPILED CODE
# ==========================================
# These folders contain temporary production code generated during site builds.
dist/
build/
.next/
out/

# ==========================================
# 4. HOSTING & DEPLOYMENT CACHES
# ==========================================
# Blocks Vercel's temporary local configuration folders and build logging data.
.vercel
.turbo
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# 5. OPERATING SYSTEM SYSTEM FILES
# ==========================================
# Hidden background tracking files generated by Mac and Windows systems.
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
